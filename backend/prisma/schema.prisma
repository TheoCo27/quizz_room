generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  online
  offline
}

enum FriendshipStatus {
  pending
  accepted
  declined
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  username String
  password String
  isGuest  Boolean @default(false)
  googleId String? @unique

  avatar_url String?
  status     UserStatus @default(offline)
  createdAt  DateTime   @default(now())

  sentPrivateMessages     PrivateMessage[] @relation("PrivateMessageSender")
  receivedPrivateMessages PrivateMessage[] @relation("PrivateMessageReceiver")

  quizLeaderboardEntries QuizLeaderboard[] @relation("UserQuizLeaderboardEntries")

  sentFriendRequests     FriendRequests[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequests[] @relation("FriendRequestReceiver")

  hostedRooms     Room[]       @relation(name: "RoomHost")
  roomMemberships RoomPlayer[]

  matchHistoryEntries MatchHistoryPlayer[]
}

model FriendRequests {
  id Int @id @default(autoincrement())

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id])
  senderId Int

  receiver   User @relation("FriendRequestReceiver", fields: [receiverId], references: [id])
  receiverId Int

  status    FriendshipStatus @default(pending)
  createdAt DateTime         @default(now())
}

model Quiz {
  id                  Int      @id @default(autoincrement())
  title               String
  questionDurationSec Int?
  createdAt           DateTime @default(now())

  questions          QuizQuestion[]    @relation("QuizQuestions")
  leaderboardEntries QuizLeaderboard[] @relation("QuizLeaderboardEntries")
}

model QuizQuestion {
  id     Int  @id @default(autoincrement())
  quiz   Quiz @relation("QuizQuestions", fields: [quizId], references: [id])
  quizId Int

  questionText  String
  answers       Json
  correctAnswer String

  position  Int
  points    Int      @default(100)
  createdAt DateTime @default(now())

  @@unique([quizId, position])
}

model QuizLeaderboard {
  id     Int  @id @default(autoincrement())
  quiz   Quiz @relation("QuizLeaderboardEntries", fields: [quizId], references: [id])
  quizId Int

  user   User @relation("UserQuizLeaderboardEntries", fields: [userId], references: [id])
  userId Int

  totalScore  Int      @default(0)
  wins        Int      @default(0)
  gamesPlayed Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([quizId, userId])
  @@index([quizId, totalScore, wins])
}

model PrivateMessage {
  id Int @id @default(autoincrement())

  sender   User @relation("PrivateMessageSender", fields: [senderId], references: [id])
  senderId Int

  receiver   User @relation("PrivateMessageReceiver", fields: [receiverId], references: [id])
  receiverId Int

  content   String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
  @@index([receiverId, readAt, createdAt])
}

enum RoomStatus {
  WAITING
  PLAYING
  FINISHED
}

enum GameType {
  QUIZ
}

model Room {
  id         String     @id @default(uuid())
  name       String?
  status     RoomStatus @default(WAITING)
  gameType   GameType
  maxPlayers Int        @default(8) // J'ai rajouter ça mais pas sur

  // relations
  hostId Int
  host   User @relation(name: "RoomHost", fields: [hostId], references: [id])

  players RoomPlayer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoomPlayer {
  id Int @id @default(autoincrement())

  // Room   link
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // link to the User
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // User state in the room
  isReady Boolean @default(false)
  isConnected Boolean @default(true)
  score   Int     @default(0) // score dans Room player. Ca peut-être plus pratique (C'est surtout une protection contre les micro coupure internet ou micro deconnexion)

  createdAt DateTime @default(now())

  @@unique([roomId, userId])
}

model MatchHistory {
  id          Int      @id @default(autoincrement())
  gameType    GameType // Pour savoir à quel jeu ils ont joué (ex: QUIZ)
  durationSec Int? // Durée de la partie en secondes (optionnel)
  createdAt   DateTime @default(now()) // Date et heure du match

  players MatchHistoryPlayer[]
}

model MatchHistoryPlayer {
  id Int @id @default(autoincrement())

  matchId Int
  match   MatchHistory @relation(fields: [matchId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  score    Int     @default(0) // Score final du joueur
  isWinner Boolean @default(false) // Pratique pour calculer les win/loss plus tard
}
